          ",",
          "<w:rPr>\n  <w:rFonts w:eastAsia=\"华文中宋\"/>\n  <w:sz w:val=\"32\"/>\n  <w:szCs w:val=\"32\"/>\n</w:rPr>"
        ]
      ]
    },
    {
      "index": 3,
      "text": "作者名（有多个作者时，每个作者需要标注相应单位，用上标*号标注通信作者",
      "style": "<d作者单位>",
      "paragraph": "<w:pPr>\n  <w:pStyle w:val=\"d\"/>\n  <w:spacing w:after=\"96\"/>\n  <w:rPr>\n    <w:color w:val=\"FF0000\"/>\n  </w:rPr>\n</w:pPr>",
