    {
      "index": 2,
      "text": "中文标题（名词性短语,尽量20个字以内）",
      "style": "a工程文章大标题",
      "paragraph": "<w:pPr>\n  <w:pStyle w:val=\"af0\"/>\n  <w:spacing w:before=\"168\"/>\n  <w:rPr>\n    <w:rFonts w:eastAsia=\"华文中宋\"/>\n    <w:sz w:val=\"32\"/>\n    <w:szCs w:val=\"32\"/>\n  </w:rPr>\n</w:pPr>",
      "runs": [
        [
          "中文标题（名词性短语",
          "<w:rPr>\n  <w:rFonts w:eastAsia=\"华文中宋\"/>\n  <w:sz w:val=\"32\"/>\n  <w:szCs w:val=\"32\"/>\n</w:rPr>"
        ],
